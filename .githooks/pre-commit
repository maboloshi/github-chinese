#!/bin/sh
# pre-commit hook：提交前验证多语言源文件 & 议题模板一致性
set -e

DOC_FILES="CONTRIBUTING.md CONTRIBUTING_zh-TW.md README.md README_zh-TW.md vscode-extension/README.md vscode-extension/README_zh-TW.md"

STAGED_SOURCES=$(git diff --cached --name-only -- "script/multilingual-docs/")
STAGED_GENERATED=$(git diff --cached --name-only -- .github/ISSUE_TEMPLATE/ | grep -v config.yml || true)
STAGED_DOCS=$(git diff --cached --name-only -- $DOC_FILES)

if [ -z "$STAGED_SOURCES" ] && [ -z "$STAGED_GENERATED" ] && [ -z "$STAGED_DOCS" ]; then
    exit 0
fi

# 优先使用 venv 的 python
PYTHON="python"
if [ -f ".venv/Scripts/python" ]; then
    PYTHON=".venv/Scripts/python"
elif [ -f ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
fi

# ── 检测到手动修改生成文件（源文件未改）→ 阻止提交并打印差异 ──
all_clean=true

for entry in "STAGED_GENERATED:.github/ISSUE_TEMPLATE/" "STAGED_DOCS:$DOC_FILES"; do
    varname="${entry%%:*}"
    diff_target="${entry#*:}"
    eval "staged=\${$varname:-}"
    [ -z "$staged" ] && continue
    [ -n "$STAGED_SOURCES" ] && continue

    if ! git diff --exit-code HEAD -- $diff_target; then
        echo -e "\n   差异如下："
        git diff HEAD -- $diff_target
        echo ""
        echo "   请通过源文件修改，不要直接编辑生成的文件。源文件："
        for f in $staged; do
            case "$f" in
                CONTRIBUTING.md|CONTRIBUTING_zh-TW.md) src="CONTRIBUTING.yml" ;;
                README.md|README_zh-TW.md) src="README.yml" ;;
                vscode-extension/README.md|vscode-extension/README_zh-TW.md) src="vscode-extension-README.yml" ;;
                *) src="" ;;
            esac
            [ -n "$src" ] && echo "   $(git rev-parse --show-toplevel)/script/multilingual-docs/${src}"
        done | sort -u
        all_clean=false
    fi
done
$all_clean || exit 1

# ── 源文件变更 → 验证 + 生成 + 自动纳入暂存 ──
if [ -n "$STAGED_SOURCES" ]; then
    echo "📋 检测到多语言源文件变更..."
    $PYTHON script/manage_templates.py --check
    $PYTHON script/manage_templates.py
    git add .github/ISSUE_TEMPLATE/ $DOC_FILES
fi
