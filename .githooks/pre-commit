#!/bin/sh
# pre-commit hook：提交前验证多语言源文件 & 议题模板一致性
set -e

STAGED_MULTILINGUAL=$(git diff --cached --name-only -- script/multilingual-issue-templates/)
STAGED_TEMPLATES=$(git diff --cached --name-only -- .github/ISSUE_TEMPLATE/ | grep -v config.yml || true)

if [ -z "$STAGED_MULTILINGUAL" ] && [ -z "$STAGED_TEMPLATES" ]; then
    exit 0
fi

# 优先使用 venv 的 python
PYTHON="python"
if [ -f ".venv/Scripts/python" ]; then
    PYTHON=".venv/Scripts/python"
elif [ -f ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
fi

# ── 情况 1：手动更改议题模板（多语言源文件未变）→ 阻止提交 ──
if [ -n "$STAGED_TEMPLATES" ] && [ -z "$STAGED_MULTILINGUAL" ]; then
        echo ""
        echo "   请通过多语言源文件修改，不要直接编辑议题模板。这些更改对应的多语言源文件："
        for f in $STAGED_TEMPLATES; do
            stem=$(echo "$f" | sed 's/-简体中文-.yml$//;s/-繁體中文-.yml$//')
            echo "   ${ROOT}/script/multilingual-issue-templates/${stem}.yml"
        done | sort -u
        echo ""
        exit 1
    fi
    exit 0
fi

# ── 情况 2：多语言源文件变更 → 验证 + 生成 + 自动纳入暂存 ──
echo "📋 检测到多语言议题模板变更..."
$PYTHON script/manage_templates.py --check
$PYTHON script/manage_templates.py
git add .github/ISSUE_TEMPLATE/
