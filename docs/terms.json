{
  "note": "GitHub 中文化术语表 —— zh-CN 词条的单一数据源，由 script/check-terms.mjs 校验 locals.js。新增/修改术语请只改这里。",
  "version": 1,
  "phrases": [
    {
      "id": "learn-more-about",
      "match": "Learn more about",
      "prefix": "了解更多关于",
      "allow": ["^了解如何", "^点击此处了解更多关于", "^深入了解"],
      "severity": "error",
      "note": "统一为「了解更多关于 X 的信息」；「了解有关…的更多信息」属冗余变体，「了解如何」保留。"
    },
    {
      "id": "are-you-sure",
      "match": "Are you sure",
      "prefix": "您确定要",
      "allow": ["^您确定吗", "^您确定不希望"],
      "severity": "error",
      "note": "确认句统一「您确定要…吗？」；独立成句的「Are you sure?」用「您确定吗」放行。"
    },
    {
      "id": "unable-to",
      "match": "Unable to",
      "prefix": "无法",
      "allow": ["^抱歉"],
      "severity": "error",
      "note": "「Unable to X」统一译「无法 X」，不写成「不能」「未能」。"
    },
    {
      "id": "you-are-about-to",
      "match": "You are about to",
      "prefix": "您即将",
      "allow": ["^您将"],
      "severity": "error",
      "note": "「You are about to X」统一「您即将 X」。"
    },
    {
      "id": "you-must",
      "match": "You must",
      "prefix": "您必须",
      "severity": "error",
      "note": "291 个键全部符合；用作防回归。"
    },
    {
      "id": "this-action",
      "match": "This action",
      "prefix": "此操作",
      "severity": "error",
      "note": "统一「此操作」，不用「该操作」。"
    },
    {
      "id": "no-matching",
      "match": "No matching",
      "prefix": "没有匹配",
      "severity": "error",
      "note": "空状态统一「没有匹配…」，不用「无匹配」「暂无匹配」。"
    }
  ],
  "banned": [
    {
      "id": "account-simplified",
      "match": "帐户",
      "severity": "error",
      "note": "#195：帐户 → 账户。"
    },
    {
      "id": "you-formal",
      "match": "你",
      "allow": ["迷你", "你好"],
      "severity": "error",
      "note": "#195：你 → 您（「迷你」「你好」除外）。"
    },
    {
      "id": "interaction",
      "match": "交互",
      "allow": ["交互式", "浏览器交互", "页面交互"],
      "severity": "error",
      "note": "#195：交互 → 互动（「交互式」「浏览器/页面交互」除外）。"
    }
  ],
  "terms": [
    {
      "id": "repository",
      "labels": ["Repositories", "Repository"],
      "words": ["repository"],
      "zh": "仓库",
      "forbid": ["存储库", "代码仓库", "代码仓"],
      "severity": "error",
      "note": "仓库 = repository；「代码库」留给 codebase，不要混用。"
    },
    {
      "id": "issue",
      "labels": ["Issues", "Issue"],
      "zh": "议题",
      "forbid": ["问题"],
      "severity": "error",
      "note": "长句里的「问题」多为普通名词（如「解决问题」），故不做整句扫描。"
    },
    {
      "id": "pull-request",
      "labels": ["Pull requests", "Pull request"],
      "words": ["pull request"],
      "zh": "拉取请求",
      "forbid": ["合并请求"],
      "severity": "error"
    },
    {
      "id": "fork",
      "labels": ["Fork", "Forks"],
      "zh": "复刻",
      "forbid": ["分叉", "派生"],
      "severity": "error"
    },
    {
      "id": "release",
      "labels": ["Releases", "Release"],
      "zh": "发行版",
      "forbid": ["发布版本"],
      "severity": "error"
    },
    {
      "id": "actions",
      "labels": ["Actions"],
      "zh": "Actions",
      "forbid": ["操作", "动作"],
      "severity": "error",
      "note": "按 issue-702 的结论保留英文；「操作」属于旧译法。"
    },
    {
      "id": "workflow",
